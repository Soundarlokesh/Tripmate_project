# --- LLM (Groq via langchain-groq) ---
GROQ_API_KEY=
# Must support tool calling. Verified in langchain-groq's model profile; confirm against Groq's docs.
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30

# --- Retrieval ---
# huggingface (default, sentence-transformers) or offline-hash (deterministic, no downloads; tests/demo only)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATA_DIR=data/destinations
FAISS_INDEX_PATH=data/index/destinations
TOP_K=3
# Minimum cosine similarity (0-1) for a chunk to be returned. Leave empty to use the per-provider default.
RELEVANCE_THRESHOLD=

# --- Weather ---
WEATHER_PROVIDER=open-meteo
WEATHER_TIMEOUT_SECONDS=10

# --- Agent / logging ---
MAX_GRAPH_STEPS=10
MAX_HISTORY_MESSAGES=30
LOG_LEVEL=INFO
